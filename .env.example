# Neon connection string — auto-provisioned by the Vercel Neon integration,
# or copy from https://console.neon.tech for local dev.
DATABASE_URL="postgresql://<user>:<password>@<host>/<db>?sslmode=require"

# Vercel Blob — create a Blob store at https://vercel.com/dashboard/stores
# and connect it to this project. Vercel injects this automatically for
# deployed environments; pull locally with `vercel env pull .env.local`.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
