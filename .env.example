# Neon connection string — auto-provisioned by the Vercel Neon integration,
# or copy from https://console.neon.tech for local dev.
DATABASE_URL="postgresql://<user>:<password>@<host>/<db>?sslmode=require"

# Clerk — auto-provisioned by the Vercel Clerk integration,
# or copy from https://dashboard.clerk.com for local dev.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Tells Clerk where the sign-in / sign-up pages live in this app.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Vercel Blob — create a Blob store at https://vercel.com/dashboard/stores
# and connect it to this project. Vercel injects this automatically for
# deployed environments; pull locally with `vercel env pull .env.local`.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
